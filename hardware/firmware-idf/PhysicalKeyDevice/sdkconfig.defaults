# NimBLE, BLE-only — no classic Bluetooth, no Bluedroid.
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y

# Custom partition table — same as the default single-app layout, plus an nvs_keys
# partition required for NVS encryption (see partitions_secure.csv).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_secure.csv"
# The flash-encryption-enabled bootloader doesn't fit in the default 0x7000 byte budget
# (offset 0x8000) — standard ESP-IDF fix is to move the partition table further out.
CONFIG_PARTITION_TABLE_OFFSET=0x10000

# Flash encryption, Development Mode: encrypts flash contents but leaves USB/serial
# reflashing working normally (Release Mode permanently disables that path, which would
# block all future firmware updates without a proper OTA system — not appropriate yet).
# NOTE: flash encryption alone does NOT cover the NVS partition (see NVS_ENCRYPTION below)
# — this is a real, documented ESP-IDF limitation, not an oversight here.
CONFIG_SECURE_FLASH_ENC_ENABLED=y
CONFIG_SECURE_FLASH_ENCRYPTION_MODE_DEVELOPMENT=y

# NVS encryption: the actual protection for the Ed25519 private key stored via
# identity.cpp's nvs_set_blob(). Original ESP32 (this board's chip) has no HMAC
# peripheral, so the flash-encryption-based key protection scheme (the Kconfig default)
# is the only option here, not a preference — it's why flash encryption above is required
# at all rather than optional.
CONFIG_NVS_ENCRYPTION=y
CONFIG_NVS_SEC_KEY_PROTECT_USING_FLASH_ENC=y
