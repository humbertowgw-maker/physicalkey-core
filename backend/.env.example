# Copy to .env and fill in before running `docker compose up` or `npm start`.
# See SELF_HOSTING.md for what each of these does.

SECRET_KEY=
ADMIN_DEVICE_ID=

# Optional — see README.md and SELF_HOSTING.md for defaults.
# ENFORCE_DEVICE_ALLOWLIST=false
# PK_BACKUP_RETAIN=14
# PK_BACKUP_INTERVAL_MS=21600000

# Optional, comma-separated — your own dev/CI machines' public IPs, so /admin/forensics
# doesn't report your own test traffic as "attacker" data. CGNAT-range IPs (100.64.0.0/10)
# are always excluded automatically — see backend/honeypot/logger.js.
# KNOWN_INTERNAL_IPS=
